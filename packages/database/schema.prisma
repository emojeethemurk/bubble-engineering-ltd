// Construction Platform — Core Database Schema (Phase 1)
// Covers: Auth/RBAC, Employees, Clients, Projects, Milestones, Tasks,
// Invoices, Documents. Further modules (HR/Payroll, Finance, Suppliers,
// CMS) extend this schema in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth / RBAC ----------

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. OWNER, PROJECT_MANAGER, SITE_ENGINEER
  description String?
  permissions Permission[]  @relation("RolePermissions")
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "projects:read", "invoices:write"
  label     String
  roles     Role[]   @relation("RolePermissions")
  createdAt DateTime @default(now())

  @@map("permissions")
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  firstName       String
  lastName        String
  isActive        Boolean       @default(true)
  twoFactorEnabled Boolean      @default(false)
  twoFactorSecret String?
  roleId          String
  role            Role          @relation(fields: [roleId], references: [id])
  employee        Employee?
  client          Client?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------- People ----------

model Employee {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String    @unique
  jobTitle     String
  department   String?
  phone        String?
  hiredAt      DateTime?
  projects     ProjectMember[]
  tasks        Task[]    @relation("TaskAssignee")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("employees")
}

model Client {
  id           String    @id @default(uuid())
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id])
  companyName  String
  contactName  String
  email        String    @unique
  phone        String?
  address      String?
  projects     Project[]
  invoices     Invoice[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("clients")
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  budget      Decimal         @db.Decimal(14, 2)
  startDate   DateTime
  endDate     DateTime?
  address     String?
  latitude    Float?
  longitude   Float?
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]
  documents   Document[]
  invoices    Invoice[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([clientId])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  roleOnSite String   // e.g. "Site Engineer", "Project Manager"
  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_members")
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime
  completed Boolean   @default(false)
  tasks     Task[]
  createdAt DateTime  @default(now())

  @@index([projectId])
  @@map("milestones")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?
  assignee    Employee?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

// ---------- Documents ----------

enum DocumentType {
  CONTRACT
  BOQ
  SITE_REPORT
  DAILY_LOG
  PHOTO
  VIDEO
  OTHER
}

model Document {
  id        String       @id @default(uuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      DocumentType
  title     String
  url       String
  uploadedBy String?
  createdAt DateTime     @default(now())

  @@index([projectId])
  @@map("documents")
}

// ---------- Finance (core only — full Finance module later) ----------

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(uuid())
  invoiceNo   String        @unique
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  amount      Decimal       @db.Decimal(14, 2)
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([projectId])
  @@index([clientId])
  @@map("invoices")
}

// ---------- Public project enquiries ----------

enum EnquiryStatus {
  NEW
  QUALIFIED
  CONTACTED
  CLOSED
}

model Enquiry {
  id           String        @id @default(uuid())
  name         String
  email        String
  phone        String
  projectType  String
  budgetRange  String
  message      String
  status       EnquiryStatus @default(NEW)
  source       String?       @default("website")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("enquiries")
}
