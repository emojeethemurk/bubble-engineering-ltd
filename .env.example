# Database
DATABASE_URL="postgresql://construction:construction_dev_password@localhost:5432/construction_platform?schema=public"

# JWT
JWT_ACCESS_SECRET="replace_with_a_random_64_character_access_secret_value"
JWT_REFRESH_SECRET="replace_with_a_random_64_character_refresh_secret_value"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Email (Resend) - fill in when Email module is built
RESEND_API_KEY=""

# Storage (Cloudinary) - fill in when Media module is built
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional integrations (never expose server secrets to the browser)
OPENAI_API_KEY=""
MAPBOX_TOKEN=""
REDIS_URL="redis://localhost:6379"
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
